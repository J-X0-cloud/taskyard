# Postgres connection used by Prisma
DATABASE_URL="postgresql://taskyard:taskyard@localhost:5432/taskyard?schema=public"

# Signs session cookies. Generate with: openssl rand -base64 48
SESSION_SECRET="replace-with-at-least-32-random-characters"

# Bearer token the scheduler sends to /api/cron/sprint-rollover
CRON_SECRET="replace-me"

# Sentry — error monitoring and performance tracing
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ENVIRONMENT="development"
NEXT_PUBLIC_SENTRY_ENVIRONMENT="development"
# Only needed where source maps are uploaded (CI)
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""

# Release identifier shown on /api/health and attached to Sentry events (set to the git SHA in CI)
NEXT_PUBLIC_RELEASE="dev"

# Public site URL, used for metadata
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
